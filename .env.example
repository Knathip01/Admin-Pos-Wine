# ==============================================================================
# The Bottle Club - Environment Variables Example
# คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าที่ถูกต้องก่อนเริ่มรันโปรเจกต์
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database Configuration (POS Store & In-House Data)
# ------------------------------------------------------------------------------
# URL ของโปรเจกต์ Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous Key (สำหรับเรียกใช้ฝั่ง Client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (สิทธิ์ Admin ระดับเซิร์ฟเวอร์ - ห้ามเปิดเผยฝั่ง Client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. External Backend API Configuration (Web Wine E-Commerce System)
# ------------------------------------------------------------------------------
# JWT Secret Key สำหรับการเข้ารหัส/ตรวจสอบสิทธิ์ Token
JWT_SECRET_KEY=your_jwt_secret_key

# Base URL ของ API ฝั่ง Client (Next.js Public)
NEXT_PUBLIC_API_BASE_URL=https://api.wayneven.uk/api/v1

# Swagger / OpenAPI Docs URL ฝั่ง Client
NEXT_PUBLIC_API_DOCS_URL=https://api.wayneven.uk/docs

# Base URL ของ API ฝั่ง Server-side (Fallback)
API_BASE_URL=https://api.wayneven.uk/api/v1

# Swagger Docs URL ฝั่ง Server-side
API_DOCS_URL=https://api.wayneven.uk/docs

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Co-Pilot Configuration
# ------------------------------------------------------------------------------
# Google Gemini API Key สำหรับระบบ Admin AI Chat Co-Pilot
GEMINI_API_KEY=your_gemini_api_key
